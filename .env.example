# Credential for the Claude bridge. Without one, JARVIS runs on its local core.
# `ANTHROPIC_AUTH_TOKEN` or an `ant auth login` profile work too.
ANTHROPIC_API_KEY=

# Bridge — the Vite dev/preview proxy reads JARVIS_PORT as well.
JARVIS_PORT=8787
JARVIS_HOST=127.0.0.1

# Model tuning. Replies are spoken aloud, so they are short by design.
JARVIS_MODEL=claude-opus-5
JARVIS_MAX_TOKENS=2048
JARVIS_EFFORT=low

# Set to `off` to disable server-side refusal fallbacks.
JARVIS_FALLBACKS=on
